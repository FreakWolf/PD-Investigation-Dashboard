{
  "name": "pd-investigation-dashboard",
  "version": "1.0.0",
  "description": "Automated Invoice & REBNI Investigation System",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "node --max-old-space-size=8192 server/server.js",
    "dev": "node --max-old-space-size=8192 server/server.js",
    "electron-dev": "electron .",
    "build-exe": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.pd.investigation.dashboard",
    "productName": "PD Investigation Dashboard",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "server/**/*",
      "public/**/*",
      "electron-main.js",
      "package.json",
      ".env"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
